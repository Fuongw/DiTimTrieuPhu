    <property name="styleSheet">
     <string notr="true">/* Trạng thái bình thường */
QPushButton {
    background-color: transparent;
    border: none;
    color: white; 
    font-size: 16px;
    font-weight: bold;
    text-align: left; 
    padding-left: 20px; 
}

/* Trạng thái khi rê chuột vào (Hover) */
QPushButton:hover {
    color: #FFD700; /* Đổi chữ sang màu Vàng Gold */
    background-color: rgba(255, 255, 255, 0.1); /* Phủ một lớp trắng mờ 10% lên nút */
    border-radius: 20px; /* Bo góc vệt sáng cho hợp với hình lục giác */
}

/* Trạng thái khi click chuột xuống (Pressed) */
QPushButton:pressed {
    color: #FF8C00; /* Đổi chữ sang màu Cam */
    background-color: rgba(255, 255, 255, 0.2);
}</string>
    </property>
